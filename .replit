modules = ["nodejs-24"]
run = "npm run dev"
entrypoint = "src/app/page.tsx"

[nix]
channel = "stable-24_05"

[deployment]
run = ["sh", "-c", "npm run start"]
deploymentTarget = "autoscale"
build = ["sh", "-c", "npm run build"]

[[ports]]
localPort = 3000
externalPort = 80

[env]
PORT = "3000"
NEXT_TELEMETRY_DISABLED = "1"
